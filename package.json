{
  "name": "zimreg_backend",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "bun build ./src/server.ts --outdir ./dist --target bun --minify",
    "start:prod": "bun ./dist/index.js",
    "start:dev": "bun --watch ./src/server.ts",
    "db:push": "drizzle-kit push"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/express": "^5.0.6",
    "@types/morgan": "^1.9.10",
    "@types/node": "^26.4.0",
    "ts-node": "^10.9.2"
  },
  "peerDependencies": {
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "express": "^5.2.1",
    "morgan": "^1.12.0",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0"
  }
}
